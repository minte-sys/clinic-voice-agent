# Copy to .env.local and fill in the three LiveKit values from your project's API keys page.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Models, as LiveKit Inference strings.
# Speech-to-text: leave STT_LANGUAGE empty to detect the language automatically.
STT_MODEL=google/gemini-3.5-transcribe-live
STT_LANGUAGE=
LLM_MODEL=openai/gpt-4.1-mini
# Text-to-speech: each language gets its own native voice and the agent switches
# between them. Defaults (Inworld): en Ashley, ar Nour, hi Riya, zh Xinyi, ru Svetlana.
# Uncomment a line to override one, e.g. TTS_VOICE_AR=Omar for a male Arabic voice.
TTS_MODEL=inworld/inworld-tts-2
# TTS_VOICE_EN=
# TTS_VOICE_AR=
# TTS_VOICE_HI=
# TTS_VOICE_ZH=
# TTS_VOICE_RU=

# Language used when the caller did not pick one: en, ar, hi, zh or ru
START_LANGUAGE=ar

# Longest wait (seconds) before deciding the caller finished speaking. Lower is faster
# but can cut people off. 1.5 is a reasonable value to try.
ENDPOINT_MAX_DELAY=2.5

# Seconds the caller must speak before the agent stops talking. Raise it (e.g. 0.8)
# if coughs or "mm-hmm" cut the agent off; lower it (e.g. 0.4) if it feels hard to stop.
INTERRUPT_MIN_DURATION=0.6

# Longest conversation in minutes before the agent says goodbye (0 = no limit).
MAX_CALL_MINUTES=8

CLINIC_DB=clinic.db
CLINIC_TZ=Asia/Dubai
AUDIT_LOG=audit.jsonl

# Web page (local). When hosted, the host sets PORT and these are ignored.
WEB_HOST=127.0.0.1
WEB_PORT=8000
# Public demo protection for the token server (see web_server.py)
TOKEN_LIMIT_PER_IP=5
TOKEN_LIMIT_GLOBAL=60
FRAME_ANCESTORS=*
