# Copy to .env.local and fill in the three LiveKit values from your project's API keys page.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Models, as LiveKit Inference strings.
# Speech-to-text: leave STT_LANGUAGE empty to detect the language automatically.
STT_MODEL=google/gemini-3.5-transcribe-live
STT_LANGUAGE=
LLM_MODEL=openai/gpt-4.1-mini
TTS_MODEL=fishaudio/s2.1-pro
TTS_VOICE=

# Language used when the caller did not pick one: en, ar, hi, zh or ru
START_LANGUAGE=ar

# Longest wait (seconds) before deciding the caller finished speaking. Lower is faster
# but can cut people off. 1.5 is a reasonable value to try.
ENDPOINT_MAX_DELAY=2.5

CLINIC_DB=clinic.db
CLINIC_TZ=Asia/Dubai
AUDIT_LOG=audit.jsonl

# Local web page
WEB_HOST=127.0.0.1
WEB_PORT=8000
